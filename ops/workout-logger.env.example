# Deployment Phase §17. Copy this to /etc/workout-logger.env on the
# production VM (not into the Git checkout) and protect it:
#   sudo chown root:workout /etc/workout-logger.env
#   sudo chmod 640 /etc/workout-logger.env
#
# No BLUEPRINT_REPO_PATH here — production reads the committed snapshot
# at src/blueprint/snapshot/, never a live Blueprint checkout. No API
# keys or LLM secrets exist in this application.

NODE_ENV=production
PORT=3000
DB_PATH=/var/lib/workout-logger/workout-logger.sqlite
