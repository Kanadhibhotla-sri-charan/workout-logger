# Deployment Phase §17. Copy this to the production VM's real
# EnvironmentFile path (see docs/POST_DEPLOYMENT_COMPLETION_REPORT.md for
# the actual, current path/user — this template's own placeholder path
# below may differ from what's really deployed) — never into the Git
# checkout — and protect it:
#   sudo chown root:workout /etc/workout-logger.env
#   sudo chmod 640 /etc/workout-logger.env
#
# No BLUEPRINT_REPO_PATH here — production reads the committed snapshot
# at src/blueprint/snapshot/, never a live Blueprint checkout.

NODE_ENV=production
PORT=3000
DB_PATH=/var/lib/workout-logger/workout-logger.sqlite

# AI Programmer (real live Velona integration) — see
# docs/REAL_AI_INTEGRATION_REPORT.md. Leave AI_PROGRAMMER_ENABLED unset
# (or false) to keep the feature fully off, exactly as before this
# integration existed. Setting it to true REQUIRES a real VELONA_API_KEY
# and VELONA_MODEL below — there is no default for either, and the app
# fails with a clear configuration error rather than silently falling
# back to deterministic generation. Fill in the real values directly on
# this file on the VM — never in the Git checkout, never in chat.
AI_PROGRAMMER_ENABLED=false
VELONA_API_KEY=
VELONA_MODEL=
# VELONA_BASE_URL=https://velona.in/gateway/v1
# VELONA_TIMEOUT_MS=60000
# VELONA_MAX_RETRIES=1
# VELONA_TEMPERATURE=0.2
# VELONA_MAX_TOKENS=4096
