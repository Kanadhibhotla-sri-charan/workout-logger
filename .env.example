# Copy to .env.local for local overrides (gitignored) — see docs/deployment.md.
# All variables are optional for local dev unless AI_PROGRAMMER_ENABLED=true.

DB_PATH=./data/workout-logger.sqlite
PORT=3000

# AI Programmer (real live Velona integration) — see
# docs/REAL_AI_INTEGRATION_REPORT.md. The feature is fully disabled
# unless AI_PROGRAMMER_ENABLED=true; when disabled, none of the
# VELONA_* variables are read and Generate returns a clear
# "AI Programmer generation is disabled" error rather than any AI
# output. When enabled, VELONA_API_KEY and VELONA_MODEL are REQUIRED —
# there is no default for either, and the app fails with a clear
# configuration error rather than falling back to deterministic
# generation silently labeled as AI.
AI_PROGRAMMER_ENABLED=false

# Placeholder only — never a real key. Get a real key from your Velona
# account dashboard and set it as a real secret in the deployment
# environment (see docs/PRODUCTION_DEPLOYMENT.md), never in this file,
# never committed to Git.
VELONA_API_KEY=

# A real model id from Velona's own catalogue (GET
# https://velona.in/gateway/v1/models) — see docs/REAL_AI_INTEGRATION_REPORT.md
# for the exact model selected and why. Example: anthropic/claude-sonnet-5
VELONA_MODEL=

# Velona's real gateway base URL — this default is correct for
# production use; only override for local testing against a different
# gateway/mock.
VELONA_BASE_URL=https://velona.in/gateway/v1

# Optional tuning, all have sane defaults (see src/ai-programmer/provider/config.ts):
# VELONA_TIMEOUT_MS=60000
# VELONA_MAX_RETRIES=1
# VELONA_TEMPERATURE=0.2
# VELONA_MAX_TOKENS=4096
